	partition FactRoute = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\fact_route.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumns(Promoted, {{"OriginID", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"DestID", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"Flights", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"PairLabel", each if _ = null or _ = "" then null else Text.From(_), type text}, {"RouteLabel", each if _ = null or _ = "" then null else Text.From(_), type text}, {"HasReturn", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}})
				in
					Typed

	annotation PBI_ResultType = Table


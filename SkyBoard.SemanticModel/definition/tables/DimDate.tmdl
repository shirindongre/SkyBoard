	partition DimDate = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumns(Promoted, {{"Date", each if _ = null or _ = "" then null else Date.FromText(_, [Format="yyyy-MM-dd", Culture="en-US"]), type date}, {"Year", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"QuarterNumber", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"MonthNumber", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"MonthName", each if _ = null or _ = "" then null else Text.From(_), type text}, {"MonthShort", each if _ = null or _ = "" then null else Text.From(_), type text}, {"Quarter", each if _ = null or _ = "" then null else Text.From(_), type text}, {"YearMonth", each if _ = null or _ = "" then null else Text.From(_), type text}, {"YearQuarter", each if _ = null or _ = "" then null else Text.From(_), type text}, {"Season", each if _ = null or _ = "" then null else Text.From(_), type text}})
				in
					Typed

	annotation PBI_ResultType = Table


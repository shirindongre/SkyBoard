table FactBaggage
	lineageTag: a8a0203f-dbe3-53e4-bfa3-8d2501c272d3

	column Airline
		dataType: string
		isHidden
		lineageTag: 7400df28-668b-560e-aee7-3d69f8e67fad
		summarizeBy: none
		sourceColumn: Airline

	column MonthStart
		dataType: dateTime
		isHidden
		formatString: mmm yyyy
		lineageTag: b0a4abf7-3026-5bb6-b573-bc8c9fa2bddd
		summarizeBy: none
		sourceColumn: MonthStart

		annotation UnderlyingDateTimeDataType = Date

	column Complaints
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 2294e940-9621-5b52-ac61-93f466efc85a
		summarizeBy: none
		sourceColumn: Complaints

	column ScheduledFlights
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: d6762881-e025-50d3-9fad-dcf7e56a4d0a
		summarizeBy: none
		sourceColumn: ScheduledFlights

	column CancelledFlights
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: b8e20b50-a086-5ec2-8ae7-30b729ac4c45
		summarizeBy: none
		sourceColumn: CancelledFlights

	column Passengers
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: ebb74de1-7049-5e41-be7e-0fb43b1cd293
		summarizeBy: none
		sourceColumn: Passengers

	partition FactBaggage = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\fact_baggage.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumns(Promoted, {{"Airline", each if _ = null or _ = "" then null else Text.From(_), type text}, {"MonthStart", each if _ = null or _ = "" then null else Date.FromText(_, [Format="yyyy-MM-dd", Culture="en-US"]), type date}, {"Complaints", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"ScheduledFlights", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"CancelledFlights", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}, {"Passengers", each if _ = null or _ = "" then null else Int64.From(Number.FromText(_, "en-US")), Int64.Type}})
				in
					Typed

	annotation PBI_ResultType = Table


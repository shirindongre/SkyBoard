table DimAirline
	lineageTag: 8b449fb7-8ab7-57b0-a626-5a27356e426f

	column Airline
		dataType: string
		lineageTag: 91147e40-4234-5b29-a777-d3150c2f3fdf
		summarizeBy: none
		sourceColumn: Airline

	partition DimAirline = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_airline.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumns(Promoted, {{"Airline", each if _ = null or _ = "" then null else Text.From(_), type text}})
				in
					Typed

	annotation PBI_ResultType = Table


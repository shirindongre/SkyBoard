            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "2 · Model and DAX",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#5FD08F",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Star schema: a marked date table, airport and airline dimensions, four fact tables.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  The airport dimension plays two roles: origin is active, destination is switched on with USERELATIONSHIP.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  91 measures in one Metrics table, grouped into nine display folders.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  SAMEPERIODLASTYEAR, TOTALYTD, DATESINPERIOD, RANKX, TOPN, ALLSELECTED and REMOVEFILTERS.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Disconnected tables drive the metric switch and the Show Top control.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Insight lines are DAX text measures, so they rewrite themselves as you filter.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"

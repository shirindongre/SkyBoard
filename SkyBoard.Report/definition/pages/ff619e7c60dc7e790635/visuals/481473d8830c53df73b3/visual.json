              {
                "textRuns": [
                  {
                    "value": "1 · Cleaning, in R",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "14pt",
                      "color": "#5FD08F",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  The airport lookup was missing names for 191 of 342 airports (56%). Rebuilt from the full BTS table, with IATA codes, states, regions and coordinates.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  On-time file: 544,003 rows collapsed to 5,812 directed routes (98.9% were duplicates); a flight-record count was kept.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Baggage file: text dates became real dates; duplicate columns and a hidden byte-order mark were removed.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Survey: 2,113 ratings of 0 (not applicable) were blanked, not averaged in. 83 missing arrival delays were imputed from departure delay (r = 0.965) and flagged.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  16 automated checks run every time the script runs.",
                    "textStyle": {
                      "fontWeight": "normal",
                      "fontSize": "10.5pt",
                      "color": "#ECEFEC",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
